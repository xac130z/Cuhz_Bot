# Twitch Bot Credentials
BOT_OAUTH_TOKEN=oauth:your_oauth_token_here
BOT_USERNAME=your_bot_username

# Optional: Specific channels to join (comma-separated, e.g. channel1,channel2)
TWITCH_CHANNEL_NAME=your_channel_name,another_channel

# Dashboard Integration (Anything.com)
DASHBOARD_URL=https://your-app.web.createdevserver.com
API_BASE=https://your-app.web.createdevserver.com
BOT_API_SECRET=your_secret_key_here
WEBHOOK_URL=https://your-app.web.createdevserver.com/api/webhook
WEBHOOK_TOKEN=your_webhook_token_here

# Server Port (Railway will set this automatically)
PORT=3000

# AI Features (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_MOOD_DETECTION=true
ENABLE_CONTEXT_AWARE=true
MOOD_ANALYSIS_INTERVAL=120
AI_RESPONSE_TIMEOUT=3000
CONTEXT_BUFFER_SIZE=20

# Testing Mode (set to true for local mock API)
USE_MOCK_API=false
