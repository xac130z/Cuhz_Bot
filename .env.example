# Twitch Bot Credentials
BOT_OAUTH_TOKEN=oauth:your_oauth_token_here
BOT_USERNAME=your_bot_username

# Optional: Specific channels to join (comma-separated, e.g. channel1,channel2)
TWITCH_CHANNEL_NAME=your_channel_name,another_channel

# Dashboard Integration (Anything.com)
DASHBOARD_URL=https://your-app.web.createdevserver.com
API_BASE=https://your-app.web.createdevserver.com
BOT_API_SECRET=your_secret_key_here
WEBHOOK_URL=https://your-app.web.createdevserver.com/api/webhook
WEBHOOK_TOKEN=your_webhook_token_here

# Planet Cuhz site integration — stream commerce & tier sync (Wave 6)
# SITE_API_* target the Supabase `bot-worker-sync` edge function and are a DIFFERENT
# trust domain than BOT_API_SECRET/API_BASE above (those are the created.app dashboard).
# SITE_API_SECRET is the VALUE of that function's own BOT_API_SECRET Supabase secret.
SITE_API_URL=https://your-project-ref.functions.supabase.co
SITE_API_SECRET=your_site_bot_api_secret_here
# Secure defaults: viewer-tier perks, the !plans commerce command family, and
# purchase thank-yous all stay OFF until the owner explicitly enables them.
ENABLE_TIER_SYNC=false
ENABLE_COMMERCE_COMMANDS=false
ENABLE_PURCHASE_SHOUTOUTS=false
# Roster-sync: when true, the bot polls the site's bot-worker-sync desired-state
# (~30s) and AUTO-JOINS channels streamers approve on planetcuhz.com — and parts
# channels they revoke. Joins are paced within Twitch limits (<=15 JOINs / 10s).
# Env TWITCH_CHANNEL_NAME channels are PROTECTED and never parted. Fail-open: a
# site outage keeps the current roster and never crashes chat. Roster-joined
# channels get the Basic/free experience (not added to CHANNEL_TIERS). Off until
# the owner flips it.
ENABLE_ROSTER_SYNC=false
# Unpublished perk — off until the 2x points perk is actually published on the ladder.
ENABLE_GOLD_POINTS_2X=false
# Keyword-intent replies: one short, code-owned cuhz-voice line on NON-command chat
# when a small intent set (help/price/what-question/bot-mention) is detected. Hard
# cooldowns (≥45s/intent, ≥5min/user, ≤1 per 60s overall), live-only, home surfaces
# only. Off until the owner explicitly enables it.
ENABLE_KEYWORD_REPLIES=false

# Server Port (Railway will set this automatically)
PORT=3000

# AI Features (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_MOOD_DETECTION=true
ENABLE_CONTEXT_AWARE=true
# Secure defaults: proactive AI, voice, chat-triggered payments, and raw chat
# retention remain off until the production gateway explicitly enables them.
ENABLE_PROACTIVE_AI=false
ENABLE_CUHZ_VOICE=false
ENABLE_CHAT_PAYMENTS=false
ENABLE_GAMBLING=false
STORE_CHAT_CONTENT=false
CHAT_RETENTION_DAYS=7
MOOD_ANALYSIS_INTERVAL=120
AI_RESPONSE_TIMEOUT=3000
CONTEXT_BUFFER_SIZE=20

# Testing Mode (set to true for local mock API)
USE_MOCK_API=false
